{
  "name": "markdown-tool",
  "version": "2.0.0",
  "description": "Convert Markdown to HTML, PDF, and PPTX using Marp — with Mermaid support, custom CSS injection, and CJK support.",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10",
  "main": "src/cli/build-cli.js",
  "scripts": {
    "build": "node src/cli/build-cli.js",
    "build:html": "node src/cli/build-cli.js --format html",
    "build:pdf": "node src/cli/build-cli.js --format pdf",
    "build:pptx": "node src/cli/build-cli.js --format pptx",
    "build:all": "node src/cli/build-cli.js content.md",
    "build:sample": "node src/cli/build-cli.js content.example.md",
    "test": "node scripts/run-tests.js",
    "clean": "node -e \"const fs=require('fs'); ['output','assets/diagrams','._temp_render.md','content-processed.md'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(_){}}); console.log('cleaned');\"",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "audit:fix:safe": "npm audit fix"
  },
  "keywords": [
    "markdown",
    "marp",
    "pdf",
    "pptx",
    "html",
    "presentation",
    "mermaid"
  ],
  "author": "wayhong0928",
  "license": "MIT",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3",
    "@mermaid-js/mermaid-cli": "^10.9.1"
  },
  "overrides": {
    "@mermaid-js/mermaid-cli": {
      "puppeteer": {
        "tar-fs": "2.1.4",
        "ws": "8.17.1"
      }
    }
  }
}
